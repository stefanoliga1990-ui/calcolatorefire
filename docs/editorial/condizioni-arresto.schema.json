{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulatorefire.com/schemas/condizioni-arresto.schema.json",
  "title": "Catalogo delle condizioni di arresto editoriali",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "updated_at", "default_actions", "conditions"],
  "properties": {
    "$schema": { "const": "./condizioni-arresto.schema.json" },
    "schema_version": { "const": "1.0" },
    "updated_at": { "type": "string", "format": "date" },
    "default_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_allowed", "push_allowed", "deployment_checked", "log_required"],
      "properties": {
        "commit_allowed": { "const": false },
        "push_allowed": { "const": false },
        "deployment_checked": { "const": false },
        "log_required": { "const": true }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code", "order", "phase", "category", "trigger", "outcome", "retry",
          "notification", "repository_state", "evidence", "recovery"
        ],
        "properties": {
          "code": { "type": "string", "pattern": "^STOP-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "order": { "type": "integer", "minimum": 1 },
          "phase": {
            "enum": ["preflight", "selection", "research", "drafting", "generation", "validation", "commit", "pre_push", "push", "execution"]
          },
          "category": { "enum": ["normal", "technical", "editorial", "concurrency"] },
          "trigger": { "type": "string", "minLength": 10 },
          "outcome": { "enum": ["no_op", "deferred", "failed", "intervention_required"] },
          "retry": { "enum": ["none", "next_schedule", "manual"] },
          "notification": { "enum": ["none", "failed_runs_only"] },
          "repository_state": { "enum": ["unchanged", "local_artifacts_allowed", "local_commit_present"] },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
          "recovery": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
