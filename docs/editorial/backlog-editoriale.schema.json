{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulatorefire.com/schemas/backlog-editoriale.schema.json",
  "title": "Backlog editoriale di Calcolo FIRE Italia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated_at",
    "selection_policy",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "./backlog-editoriale.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_status",
        "automation_eligible",
        "dependencies_must_have_status",
        "order_by",
        "maximum_items_per_run",
        "when_no_item_matches"
      ],
      "properties": {
        "required_status": {
          "const": "ready"
        },
        "automation_eligible": {
          "const": true
        },
        "dependencies_must_have_status": {
          "const": "pushed_to_main"
        },
        "order_by": {
          "const": [
            "priority_ascending",
            "sequence_ascending"
          ]
        },
        "maximum_items_per_run": {
          "const": 1
        },
        "when_no_item_matches": {
          "const": "stop_without_changes"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_type",
        "status",
        "execution_mode",
        "automation_eligible",
        "sequence",
        "priority",
        "slug",
        "working_title",
        "cluster",
        "parent_id",
        "search_intent",
        "primary_query",
        "secondary_queries",
        "reader_outcome",
        "unique_value",
        "simulator_features",
        "source_focus",
        "risk_level",
        "freshness",
        "dependencies",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(GUIDE|METH)-[0-9]{4}$"
        },
        "content_type": {
          "enum": [
            "guide",
            "methodology"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "pilot",
            "ready",
            "in_progress",
            "pushed_to_main",
            "needs_correction",
            "blocked",
            "discarded"
          ]
        },
        "execution_mode": {
          "enum": [
            "manual_prerequisite",
            "manual_pilot",
            "automatic"
          ]
        },
        "automation_eligible": {
          "type": "boolean"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "slug": {
          "type": "string",
          "pattern": "^/(guida/[a-z0-9]+(?:-[a-z0-9]+)*|metodologia)$"
        },
        "working_title": {
          "type": "string",
          "minLength": 1
        },
        "cluster": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(GUIDE|METH)-[0-9]{4}$"
        },
        "search_intent": {
          "type": "string",
          "minLength": 1
        },
        "primary_query": {
          "type": "string",
          "minLength": 1
        },
        "secondary_queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reader_outcome": {
          "type": "string",
          "minLength": 1
        },
        "unique_value": {
          "type": "string",
          "minLength": 1
        },
        "simulator_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "freshness": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(GUIDE|METH)-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content_type": {
                "const": "methodology"
              }
            },
            "required": [
              "content_type"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^METH-[0-9]{4}$"
              },
              "slug": {
                "const": "/metodologia"
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "pattern": "^GUIDE-[0-9]{4}$"
              },
              "slug": {
                "pattern": "^/guida/[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_mode": {
                "const": "automatic"
              }
            },
            "required": [
              "execution_mode"
            ]
          },
          "then": {
            "properties": {
              "automation_eligible": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "automation_eligible": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pilot"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "execution_mode": {
                "const": "manual_pilot"
              },
              "automation_eligible": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
